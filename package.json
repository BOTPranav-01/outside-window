{
  "name": "outside-window",
  "version": "0.1.0",
  "private": true,
  "description": "A privacy-first personal agent for finding a good time to go outside.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "eval": "python prediction/eval.py --demo",
    "csv:export": "tsx scripts/csv.ts export",
    "csv:import": "tsx scripts/csv.ts import"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
